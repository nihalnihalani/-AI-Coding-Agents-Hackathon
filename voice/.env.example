# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# AI Agent Application URLs
AI_AGENT_FRONTEND=http://localhost:3000
AI_AGENT_BACKEND=http://localhost:8000

# Voice Assistant Configuration
VOICE_MODEL=models/gemini-2.5-flash-exp-native-audio-thinking-dialog
VOICE_NAME=Zephyr
LANGUAGE_CODE=en-US

# Screen Capture Settings
SCREEN_CAPTURE_INTERVAL=2.0
SCREEN_RESOLUTION=MEDIA_RESOLUTION_MEDIUM

# Audio Settings
AUDIO_FORMAT=paInt16
AUDIO_CHANNELS=1
SEND_SAMPLE_RATE=16000
RECEIVE_SAMPLE_RATE=24000
CHUNK_SIZE=1024